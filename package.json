{
  "name": "ruibreath",
  "version": "0.0.1",
  "description": "瑞谱斯客户端",
  "author": "luoweihao",
  "main": "dist/electron/main/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:web": "vue-tsc --noEmit && vite build",
    "build:win": "vite build && electron-builder --win --x64",
    "build:ia32": "vite build && electron-builder --win --ia32",
    "build:mac": "vite build && electron-builder --mac",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist release"
  },
  "dependencies": {
    "node-hid": "^3.2.0",
    "serialport": "^12.0.0",
    "usb": "^2.15.0"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.19",
    "@types/node": "^22.15.32",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/core": "^12.8.2",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "element-plus": "^2.10.2",
    "nprogress": "^0.2.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "sass-embedded": "^1.89.2",
    "tree-kill": "^1.2.2",
    "typescript": "~5.6.3",
    "unocss": "66.7.2",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.12.0",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-style-import": "^2.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vue": "^3.5.17",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10",
    "zod": "^3.25.67"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
