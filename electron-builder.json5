
/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "productName": "xxx客户端",
  "appId": "com.test.xxx",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "!**/node_modules/**",
    "!**/*.map",
  ],
  "mac": {
    "artifactName": "${productName}_${version}.${ext}",
    "icon": "dist/icon.ico",
    "target": [
      "dmg"
    ]
  },
  "win": {
    "icon": "dist/icon.ico",
    "target": "nsis",
    "artifactName": "${productName}_${version}.${ext}"
  },
  "nsis": {
    "shortcutName": "xxx客户端",
    "oneClick": false, // 禁用一键安装 ,允许用户交互
    "perMachine": true, // 
    "allowToChangeInstallationDirectory": true, // 可修改安装路径
    "deleteAppDataOnUninstall": false, // 卸载时删除数据
    "createDesktopShortcut": true,  // 创建桌面快捷方式
    "createStartMenuShortcut": true, // 创建开始菜单快捷方式
    "installerHeaderIcon": "dist/icon.ico",
  }
}